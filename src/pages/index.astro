---
import Card from '../layouts/Card.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Mascot from '../components/Mascot.astro';
import Blood from '../components/Blood.astro';
import { site } from '../site.config';
import { getFeaturedProjects } from '../lib/projects';
import { useStrings } from '../i18n';

const t = useStrings();
const featured = await getFeaturedProjects(4);
---

<Card>
  <section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title" class="lead">{site.tagline}</h1>
    <div class="perch">
      <Blood kind="pool" scale={3} scaleSmall={2} bottom="-4px" left="-30%" />
      <Blood kind="specks" scale={3} scaleSmall={2} bottom="34%" left="-12%" />
      <Mascot />
    </div>
  </section>

  <section class="projects" aria-labelledby="projects-heading">
    <div class="head">
      <h2 id="projects-heading" class="label">{t.home.projects}</h2>
      <a class="link" href="/projects">{t.home.viewAll}</a>
    </div>
    <ProjectGrid projects={featured} />
  </section>
</Card>

<style>
  /* the cat sits on the hero's bottom border */
  .hero {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s3);
    border-bottom: var(--border-w) solid var(--line);
  }
  .lead {
    padding-bottom: var(--s4);
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-strong);
  }
  .perch {
    position: relative;
    margin: 0 var(--s3) 0 auto;
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s2);
    font-size: var(--fs-sm);
  }

  @media (max-width: 560px) {
    .lead {
      padding-bottom: 0;
    }
  }
</style>
