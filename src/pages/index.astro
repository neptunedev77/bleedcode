---
import Card from '../layouts/Card.astro';
import ProjectsBrowser from '../components/ProjectsBrowser.astro';
import Mascot from '../components/Mascot.astro';
import Blood from '../components/Blood.astro';
import { site } from '../site.config';
import { getFeaturedProjects } from '../lib/projects';
import { useStrings } from '../i18n';

const t = useStrings();
const featured = await getFeaturedProjects(4);
const [line1, line2] = site.hero.lines;
---

<Card>
  <section class="hero" aria-labelledby="hero-title">
    <div class="copy">
      <h1 id="hero-title" class="headline">
        <span class="l1">{line1}</span>
        <span class="l2">
          {line2}
          <svg class="spark" viewBox="0 0 7 7" width="21" height="21" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
            <path d="M3 0h1v2H3zM3 5h1v2H3zM0 3h2v1H0zM5 3h2v1H5zM2 2h3v3H2z"></path>
          </svg>
        </span>
      </h1>
      <p class="meta">{site.hero.meta}</p>
    </div>
    <div class="perch">
      <Blood kind="pool" scale={3} scaleSmall={2} bottom="-4px" left="-30%" />
      <Blood kind="specks" scale={3} scaleSmall={2} bottom="34%" left="-12%" />
      <Mascot />
    </div>
  </section>

  <ProjectsBrowser projects={featured} title={t.home.projects} more={{ href: '/projects', label: t.home.viewAll }} />
</Card>

<style>
  /* the cat sits on the hero's bottom border */
  .hero {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s3);
    border-bottom: var(--border-w) solid var(--line);
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    padding-bottom: var(--s4);
    max-width: 620px;
    flex: 1 1 420px;
  }
  .headline {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: var(--fs-xl);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .l1 {
    color: var(--text-strong);
  }
  .l2 {
    color: var(--accent);
  }
  .spark {
    display: inline-block;
    margin-left: var(--s1);
    vertical-align: 0.15em;
    fill: var(--text-strong);
    image-rendering: pixelated;
  }
  .meta {
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.7;
    color: var(--muted);
  }
  .perch {
    position: relative;
    margin: 0 var(--s3) 0 auto;
  }

  @media (max-width: 560px) {
    .headline {
      font-size: var(--s4);
    }
    .copy {
      padding-bottom: 0;
    }
  }
</style>
