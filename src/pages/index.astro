---
import Card from '../layouts/Card.astro';
import ProjectsBrowser from '../components/ProjectsBrowser.astro';
import Mascot from '../components/Mascot.astro';
import Blood from '../components/Blood.astro';
import { site } from '../site.config';
import { getHomeOrder } from '../lib/projects';
import { useStrings } from '../i18n';

const t = useStrings();
const ordered = await getHomeOrder();
const shown = ordered.slice(0, 2);
const [line1, line2] = site.hero.lines;
---

<Card>
  <section class="hero" aria-labelledby="hero-title">
    <div class="copy">
      <h1 id="hero-title" class="headline">
        <span class="line l1"><span class="in">{line1}</span></span>
        <span class="line l2">
          <span class="in">
            {line2}
            <svg class="spark" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
              <path d="M3 0h1v2H3zM3 5h1v2H3zM0 3h2v1H0zM5 3h2v1H5zM2 2h3v3H2z"></path>
            </svg>
          </span>
        </span>
      </h1>
      <p class="meta">{site.hero.meta}</p>
    </div>
    <div class="perch">
      <Blood kind="pool" scale={3} scaleSmall={2} bottom="-4px" left="-30%" />
      <Blood kind="specks" scale={3} scaleSmall={2} bottom="34%" left="-12%" />
      <Mascot />
    </div>
  </section>

  <ProjectsBrowser
    projects={shown}
    title={t.home.projects}
    filters={false}
    teaser={{ href: '/projects', label: t.home.explore(ordered.length) }}
  />
</Card>

<style>
  /* the cat sits on the hero's bottom border */
  .hero {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s3);
    border-bottom: var(--border-w) solid var(--line);
  }
  .copy {
    /* lets the second line size itself to the space it has */
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    padding-bottom: var(--s4);
    max-width: 640px;
    flex: 1 1 420px;
  }
  .headline {
    display: flex;
    flex-direction: column;
    gap: var(--s1);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .line {
    display: block;
    /* each line is revealed through its own window; a little room for descenders */
    overflow: clip;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .in {
    display: inline-block;
  }
  .l1 {
    font-size: var(--fs-xl);
    line-height: 1.1;
    color: var(--text-strong);
  }
  /* one line at any width: about 22.5em wide in Plex Mono, so scale to fit */
  .l2 {
    font-size: min(var(--fs-lg), 100cqi / 22.5);
    line-height: 1.3;
    white-space: nowrap;
    color: var(--accent);
  }
  .spark {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    margin-left: 0.3em;
    vertical-align: -0.02em;
    fill: var(--text-strong);
    image-rendering: pixelated;
  }
  .meta {
    font-size: var(--fs-md);
    font-weight: 500;
    line-height: 1.6;
    color: var(--muted);
  }
  .perch {
    position: relative;
    margin: 0 var(--s3) 0 auto;
  }

  /* entrance: each line drops into its window, then the meta line and the spark */
  @media (prefers-reduced-motion: no-preference) {
    .in {
      animation: drop 700ms var(--ease) both;
    }
    .l2 .in {
      animation-delay: 90ms;
    }
    .meta {
      animation: rise 600ms var(--ease) 260ms both;
    }
    .spark {
      animation: spark 500ms var(--ease) 560ms both;
    }
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-105%);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @keyframes spark {
    from {
      opacity: 0;
      transform: scale(0.2) rotate(-90deg);
    }
  }

  @media (max-width: 560px) {
    .l1 {
      font-size: var(--s4);
    }
    .copy {
      padding-bottom: 0;
    }
  }
</style>
