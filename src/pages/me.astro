---
import Card from '../layouts/Card.astro';
import Chips from '../components/Chips.astro';
import ActionLink from '../components/ActionLink.astro';
import Mascot from '../components/Mascot.astro';
import Blood from '../components/Blood.astro';
import { site } from '../site.config';
import { useStrings } from '../i18n';
import { about, focus, offline, education } from '../data/me';

const t = useStrings();
---

<Card title={t.me.title} description={t.me.description}>
  <div class="me">
    <section class="intro" aria-labelledby="page-title">
      <h1 id="page-title" class="label">{t.me.title}</h1>
      <p class="hello">{site.tagline}</p>
      {about.map((line) => <p class="about">{line}</p>)}
    </section>

    <aside class="perch" aria-hidden="true">
      <Blood kind="specks" scale={2} bottom="6px" left="-18px" />
      <Mascot scale={2} scaleSmall={2} alt="" />
    </aside>

    <section class="block" aria-labelledby="edu-heading">
      <h2 id="edu-heading" class="label">{t.me.education}</h2>
      <ol class="timeline">
        {
          education.map((e) => (
            <li class:list={{ current: !e.end }}>
              <span class="node" aria-hidden="true" />
              <p class="years">
                {e.start} – {e.end ?? t.me.present}
                {!e.end && <span class="now">{t.me.now}</span>}
              </p>
              <h3 class="degree">
                {e.degree} <span class="level">{e.level}</span>
              </h3>
              <p class="school">
                {e.school} · {e.place}
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="block" aria-labelledby="interests-heading">
      <h2 id="interests-heading" class="label">{t.me.interests}</h2>
      <div class="groups">
        <div>
          <h3 class="group">{t.me.focus}</h3>
          <Chips items={focus} />
        </div>
        <div>
          <h3 class="group">{t.me.offline}</h3>
          <Chips items={offline} />
        </div>
      </div>
    </section>

    <section class="block" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="label">{t.me.contact}</h2>
      <div class="actions">
        <ActionLink href={`mailto:${site.email}`} label={site.email} icon="mail" />
        <ActionLink href={site.github} label={`github.com/${site.githubUser}`} icon="github" />
      </div>
    </section>
  </div>
</Card>

<style>
  .me {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s5) var(--s4);
    align-items: end;
  }
  .block {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }

  /* section labels get a small red pixel */
  .label::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: var(--s1);
    background: var(--accent);
    vertical-align: 1px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    max-width: 62ch;
  }
  .hello {
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-strong);
  }
  .about {
    color: var(--text);
  }
  /* a short ledge, so the cat sits on something */
  .perch {
    position: relative;
    margin-right: var(--s3);
    padding: 0 var(--s3);
    border-bottom: var(--border-w) solid var(--line-strong);
  }

  /* education timeline */
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    margin: 0;
    padding: 0 0 0 var(--s4);
    list-style: none;
  }
  .timeline::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 7px;
    border-left: 2px dashed var(--line-strong);
  }
  .timeline li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--s2);
    background: var(--inner);
    border: var(--border-w) solid var(--line);
    transition: border-color var(--t-fast) var(--ease);
  }
  .timeline li:hover {
    border-color: var(--line-strong);
  }
  .node {
    position: absolute;
    top: 20px;
    left: calc(-1 * var(--s4));
    width: 16px;
    height: 16px;
    background: var(--card);
    border: 2px solid var(--line-strong);
  }
  .current {
    border-color: var(--accent) !important;
  }
  .current .node {
    background: var(--accent);
    border-color: var(--accent);
  }
  .years {
    display: flex;
    align-items: center;
    gap: var(--s1);
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .now {
    padding: 0 var(--s1);
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
  }
  .degree {
    font-size: var(--fs-md);
    font-weight: 700;
    color: var(--text-strong);
  }
  .level {
    margin-left: var(--s1);
    padding: 0 var(--s1);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--text-soft);
    border: var(--border-w) solid var(--line-strong);
  }
  .school {
    font-size: var(--fs-sm);
    color: var(--text-soft);
  }

  /* interests */
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--s3);
  }
  .group {
    margin-bottom: var(--s1);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }

  @media (max-width: 560px) {
    .me {
      grid-template-columns: 1fr;
    }
    .perch {
      display: none;
    }
    .timeline {
      padding-left: var(--s3);
    }
    .node {
      left: calc(-1 * var(--s3));
      width: 12px;
      height: 12px;
    }
    .timeline::before {
      left: 5px;
    }
  }
</style>
