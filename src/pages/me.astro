---
import Card from '../layouts/Card.astro';
import Chips from '../components/Chips.astro';
import { site } from '../site.config';
import { useStrings } from '../i18n';

const t = useStrings();
---

<Card title={t.me.title} description={t.me.description}>
  <article class="me" aria-labelledby="page-title">
    <h1 id="page-title" class="label">{t.me.title}</h1>

    <div class="who">
      <p class="name">{site.author}</p>
      <p class="lead">{site.intro}</p>
    </div>

    <section aria-labelledby="focus-heading">
      <h2 id="focus-heading" class="label">{t.me.focus}</h2>
      <Chips items={site.focus} />
    </section>

    <section aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="label">{t.me.contact}</h2>
      <ul class="contact">
        <li>
          <span>email</span>
          <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <span>github</span>
          <a class="link" href={site.github}>github.com/{site.githubUser} ↗</a>
        </li>
      </ul>
    </section>
  </article>
</Card>

<style>
  .me {
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    max-width: 68ch;
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: var(--s1);
  }
  .name {
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--text-strong);
  }
  .lead {
    color: var(--text-soft);
  }
  section {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }
  .contact {
    display: flex;
    flex-direction: column;
    gap: var(--s1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contact li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--s2);
  }
  .contact span {
    min-width: 8ch;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
</style>
