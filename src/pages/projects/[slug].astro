---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Card from '../../layouts/Card.astro';
import ProjectIcon from '../../components/ProjectIcon.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Chips from '../../components/Chips.astro';
import { getProjects, repoUrl, prettyUrl, type Project } from '../../lib/projects';
import { useStrings } from '../../i18n';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const t = useStrings();
const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);
---

<Card title={p.name} description={`${p.name}: ${p.tagline}`}>
  <article class="project" aria-labelledby="page-title">
    <a class="link back" href="/projects">{t.project.back}</a>

    <div class="intro">
      <ProjectIcon icon={p.icon} logo={p.logo} />
      <div class="heading">
        <div class="title">
          <h1 id="page-title">{p.name}</h1>
          <StatusBadge status={p.status} />
        </div>
        <p class="tagline">{p.tagline}</p>
        <p class="kind">{t.project.kind[p.kind]}</p>
      </div>
    </div>

    <div class="prose">
      <Content />
    </div>

    {
      p.features.length > 0 && (
        <section aria-labelledby="features-heading">
          <h2 id="features-heading" class="label">{t.project.features}</h2>
          <ul class="features">
            {p.features.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="stack-heading">
      <h2 id="stack-heading" class="label">{t.project.stack}</h2>
      <Chips items={p.stack} />
    </section>

    {
      (p.url || p.repo) && (
        <section aria-labelledby="links-heading">
          <h2 id="links-heading" class="label">{t.project.links}</h2>
          <ul class="links">
            {p.url && (
              <li>
                <span>{t.project.live}</span>
                <a class="link" href={p.url}>{prettyUrl(p.url)} ↗</a>
              </li>
            )}
            {p.repo && (
              <li>
                <span>{t.project.repo}</span>
                <a class="link" href={repoUrl(p.repo)}>github.com/{p.repo} ↗</a>
              </li>
            )}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="shots-heading">
      <h2 id="shots-heading" class="label">{t.project.screenshots}</h2>
      {
        p.screenshots.length > 0 ? (
          <div class="shots">
            {p.screenshots.map((s) => (
              <figure>
                <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        ) : (
          <p class="no-shots">{t.project.noScreenshots}</p>
        )
      }
    </section>
  </article>
</Card>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: var(--s4);
  }
  .back {
    align-self: flex-start;
    font-size: var(--fs-sm);
  }
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
  }
  .heading {
    display: flex;
    flex-direction: column;
    gap: var(--s1);
    min-width: 0;
    flex: 1 1 280px;
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s1) var(--s2);
  }
  h1 {
    font-size: var(--fs-xl);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-strong);
    overflow-wrap: anywhere;
  }
  .tagline {
    color: var(--text-soft);
  }
  .kind {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .prose {
    max-width: 68ch;
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }
  section {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: var(--s1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--s2);
  }
  .links span {
    min-width: 12ch;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .links a {
    overflow-wrap: anywhere;
  }
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--s1) var(--s3);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 90ch;
  }
  .features li {
    position: relative;
    padding-left: var(--s3);
    color: var(--text-soft);
  }
  /* a red pixel as the bullet */
  .features li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 8px;
    height: 8px;
    background: var(--accent);
  }
  .no-shots {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 160px;
    padding: var(--s3);
    font-size: var(--fs-sm);
    color: var(--dim);
    border: var(--border-w) dashed var(--line-strong);
    border-radius: var(--radius-sm);
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: var(--s2);
  }
  figure {
    background: var(--inner);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  figure img {
    width: 100%;
    height: auto;
  }
  @media (max-width: 560px) {
    h1 {
      font-size: var(--s4);
    }
  }
</style>
