---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Card from '../../layouts/Card.astro';
import ProjectLogo from '../../components/ProjectLogo.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Chips from '../../components/Chips.astro';
import Stain from '../../components/Stain.astro';
import { getProjects, repoUrl, prettyUrl, type Project } from '../../lib/projects';
import { useStrings } from '../../i18n';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const t = useStrings();
const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);
---

<Card title={p.name} description={`${p.name}: ${p.tagline}`}>
  <article class="project dashed-top" aria-labelledby="page-title">
    <a class="back pixel" href="/projects">{t.project.back}</a>

    <div class="intro">
      <div class="logo px-border">
        <Stain kind="corner" scale={3} top="-4px" left="-4px" />
        <ProjectLogo name={p.name} monogram={p.monogram} logo={p.logo} live={p.status === 'live'} />
      </div>
      <div class="heading">
        <div class="title">
          <h1 id="page-title">{p.name}</h1>
          <StatusBadge status={p.status} />
          <span class="kind pixel">{t.project.kind[p.kind]}</span>
        </div>
        <p class="tagline">{p.tagline}</p>
      </div>
    </div>

    <div class="prose">
      <Content />
    </div>

    <section aria-labelledby="stack-heading">
      <h2 id="stack-heading" class="sub pixel">{t.project.stack}</h2>
      <Chips items={p.stack} />
    </section>

    {
      (p.url || p.repo) && (
        <section aria-labelledby="links-heading">
          <h2 id="links-heading" class="sub pixel">{t.project.links}</h2>
          <ul class="links">
            {p.url && (
              <li>
                <span class="pixel">{t.project.live}</span>
                <a class="link-under" href={p.url}>{prettyUrl(p.url)} ↗</a>
              </li>
            )}
            {p.repo && (
              <li>
                <span class="pixel">{t.project.repo}</span>
                <a class="link-under" href={repoUrl(p.repo)}>github.com/{p.repo} ↗</a>
              </li>
            )}
          </ul>
        </section>
      )
    }

    {
      p.screenshots.length > 0 && (
        <section aria-labelledby="shots-heading">
          <h2 id="shots-heading" class="sub pixel">{t.project.screenshots}</h2>
          <div class="shots">
            {p.screenshots.map((s) => (
              <figure class="px-border">
                <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        </section>
      )
    }
  </article>
</Card>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 26px;
  }
  .back {
    align-self: flex-start;
    font-size: 11px;
    color: var(--muted);
  }
  .back:hover {
    color: var(--link-hover);
  }
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 28px;
  }
  .logo {
    position: relative;
    flex: none;
  }
  .heading {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    flex: 1 1 280px;
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
  }
  h1 {
    font-size: 40px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-strong);
    overflow-wrap: anywhere;
  }
  .kind {
    font-size: 11px;
    color: var(--muted);
  }
  .tagline {
    color: var(--text-soft);
  }
  .prose {
    max-width: 68ch;
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: var(--text);
  }
  .prose :global(a) {
    border-bottom: 2px solid var(--accent);
  }
  section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .sub {
    font-size: 13px;
    color: var(--text-strong);
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
  }
  .links .pixel {
    min-width: 110px;
    font-size: 11px;
    color: var(--muted);
  }
  .links a {
    overflow-wrap: anywhere;
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 26px;
  }
  figure {
    margin: 0;
    background: var(--inner);
  }
  figure img {
    width: 100%;
    height: auto;
  }
</style>
