---
import Card from '../../layouts/Card.astro';
import ProjectsBrowser from '../../components/ProjectsBrowser.astro';
import { getProjects } from '../../lib/projects';
import { useStrings } from '../../i18n';

const t = useStrings();
const projects = await getProjects();
---

<Card title={t.projects.title} description={t.projects.description}>
  <ProjectsBrowser projects={projects} title={t.projects.title} as="h1" />
</Card>
