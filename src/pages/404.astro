---
import Card from '../layouts/Card.astro';
import Mascot from '../components/Mascot.astro';
import Stain from '../components/Stain.astro';
import { useStrings } from '../i18n';

const t = useStrings();
---

<Card title={t.notFound.title} description={t.notFound.message} index={false}>
  <section class="nf dashed-top" aria-labelledby="page-title">
    <div class="text">
      <h1 id="page-title" class="label">{t.notFound.title}</h1>
      <p>{t.notFound.message}</p>
      <a class="link-under" href="/">{t.notFound.home}</a>
    </div>
    <div class="perch">
      <Stain kind="puddle" scale={3} bottom="-6px" left="-22px" />
      <Mascot scale={2} />
    </div>
  </section>
</Card>

<style>
  .nf {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    padding-top: 26px;
    /* the cat sits on the footer's dashed line */
    margin-bottom: -34px;
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding-bottom: 26px;
  }
  .perch {
    position: relative;
    margin: 0 24px 0 auto;
  }
  .perch :global(.mascot) {
    position: relative;
    z-index: 2;
    margin-bottom: -3px;
  }
</style>
