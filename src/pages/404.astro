---
import Card from '../layouts/Card.astro';
import Mascot from '../components/Mascot.astro';
import { useStrings } from '../i18n';

const t = useStrings();
---

<Card title={t.notFound.title} description={t.notFound.message} index={false}>
  <section class="nf" aria-labelledby="page-title">
    <div class="text">
      <h1 id="page-title" class="label">{t.notFound.title}</h1>
      <p>{t.notFound.message}</p>
      <a class="link" href="/">{t.notFound.home}</a>
    </div>
    <Mascot class="cat" scale={3} scaleSmall={2} />
  </section>
</Card>

<style>
  .nf {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s3);
    /* the cat sits on the footer's top border */
    margin-bottom: calc(var(--s4) * -1);
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s2);
    padding-bottom: var(--s4);
  }
  .nf :global(.cat) {
    margin: 0 var(--s3) 0 auto;
  }
</style>
