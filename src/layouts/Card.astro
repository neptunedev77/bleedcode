---
/**
 * The one layout: page shell, centered card, header, page content and footer.
 */
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/700.css';
import '@fontsource/silkscreen/400.css';
import '../styles/global.css';

import { site } from '../site.config';
import { defaultLocale } from '../i18n';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Set false for pages that should not be indexed (404). */
  index?: boolean;
}

const { title, description = site.description, index = true } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const base = Astro.site ?? site.url;
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL('/og.png', base).href;
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0d" />
    <meta name="color-scheme" content="dark" />
    {!index && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The bleedcode cat on a dark background" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="page">
      <div class="card">
        <SiteHeader />
        <main id="main">
          <slot />
        </main>
        <SiteFooter />
      </div>
    </div>
  </body>
</html>

<style>
  .page {
    padding: var(--s3) var(--s2) var(--s5);
  }
  .card {
    max-width: var(--card-max);
    margin: 0 auto;
    padding: var(--card-pad);
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    background: var(--card);
    border: var(--border-w) solid var(--frame);
  }
  main {
    display: flex;
    flex-direction: column;
    gap: var(--s4);
  }
  @media (max-width: 560px) {
    .page {
      padding: var(--s2) var(--s1) var(--s4);
    }
  }
</style>
