---
import { site } from '../site.config';
import { useStrings, formatDate } from '../i18n';

const t = useStrings();
const built = new Date();
---

<footer class="footer">
  <a class="link copy" href={`mailto:${site.email}`} data-copy={site.email}>
    <span data-copy-text>{site.email}</span>
  </a>
  <p class="updated">
    {t.footer.updated}{' '}<time datetime={built.toISOString().slice(0, 10)}>{formatDate(built)}</time>
  </p>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s1) var(--s3);
    padding-top: var(--s3);
    border-top: var(--border-w) solid var(--line);
    font-size: var(--fs-sm);
  }
  .updated {
    color: var(--dim);
  }
</style>
