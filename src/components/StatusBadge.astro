---
import { useStrings } from '../i18n';
import Blood from './Blood.astro';

interface Props {
  status: 'live' | 'wip' | 'archived';
}

const t = useStrings();
const { status } = Astro.props;
---

<span class:list={['badge', status]}>
  {t.status[status]}
  {status === 'live' && <Blood kind="drop" scale={2} class="drop" />}
</span>

<style>
  .badge {
    position: relative;
    flex: none;
    padding: 0 var(--s1);
    font-size: var(--fs-sm);
    font-weight: 700;
    line-height: 1.5;
    color: var(--muted);
    border: var(--border-w) solid var(--line);
  }
  .live {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  /* a tiny drop hanging from the chip's bottom edge */
  .live :global(.drop) {
    top: 100%;
    right: 6px;
  }
</style>
