---
import { useStrings } from '../i18n';

interface Props {
  status: 'live' | 'wip' | 'archived';
}

const t = useStrings();
const { status } = Astro.props;
---

<span class:list={['badge', status]}>{t.status[status]}</span>

<style>
  .badge {
    flex: none;
    padding: 0 var(--s1);
    font-size: var(--fs-sm);
    font-weight: 700;
    line-height: 1.5;
    color: var(--muted);
    border: var(--border-w) solid var(--line);
  }
  .live {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
</style>
