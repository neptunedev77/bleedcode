---
import { site } from '../site.config';
import { useStrings } from '../i18n';

const t = useStrings();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const tiles = [
  { key: 'projects', href: '/projects', label: t.nav.projects, accent: true },
  { key: 'me', href: '/me', label: t.nav.me },
  { key: 'github', href: site.github, label: t.nav.github },
  { key: 'contact', href: `mailto:${site.email}`, label: t.nav.contact },
] as const;
---

<nav aria-label={t.nav.label}>
  <ul>
    {
      tiles.map((tile) => (
        <li>
          <a href={tile.href} aria-current={path === tile.href ? 'page' : undefined}>
            <span class:list={['tile', 'px-border', { accent: 'accent' in tile }]}>
              {tile.key === 'projects' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
                  <rect x="3" y="3" width="7" height="7" />
                  <rect x="14" y="3" width="7" height="7" />
                  <rect x="3" y="14" width="7" height="7" />
                  <rect x="14" y="14" width="7" height="7" />
                </svg>
              )}
              {tile.key === 'me' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
                  <rect x="8" y="3" width="8" height="8" />
                  <path d="M4 21v-3a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v3" />
                </svg>
              )}
              {tile.key === 'github' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 19c-4 1.5-4-2-6-2.5M15 22v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V22" />
                </svg>
              )}
              {tile.key === 'contact' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" />
                  <path d="m3 7 9 6 9-6" />
                </svg>
              )}
            </span>
            <span class="pixel name">{tile.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 76px;
  }
  .tile {
    --px-c: var(--border-tile);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background: var(--inner);
    color: var(--text);
  }
  .tile.accent {
    color: var(--accent);
  }
  .name {
    font-size: 11px;
    color: var(--text-soft);
  }
  a:hover .tile,
  a[aria-current='page'] .tile {
    --px-c: var(--border-light);
  }
  a:hover .name {
    color: var(--link-hover);
  }
  @media (max-width: 400px) {
    ul {
      gap: 10px;
    }
    a {
      width: 66px;
    }
  }
</style>
