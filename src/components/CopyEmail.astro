---
/**
 * Live region for the click-to-copy feedback, plus the strings it uses.
 * The behaviour lives in public/js/site.js (external, so the CSP can stay
 * `script-src 'self'`). Mark a link with `data-copy="address"` to enable it.
 */
import { useStrings } from '../i18n';

const t = useStrings();
---

<div
  class="visually-hidden"
  role="status"
  aria-live="polite"
  data-copy-status
  data-done={t.copy.done}
  data-announce={t.copy.announce}
>
</div>
