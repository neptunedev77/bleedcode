---
/**
 * Project card. The project name is the main link and is stretched over the
 * whole card. Live projects also get a "visit" button in the title row
 * (a sibling link, never nested in the main one) and a splash of blood.
 */
import { repoUrl, type Project } from '../lib/projects';
import { useStrings } from '../i18n';
import ProjectIcon from './ProjectIcon.astro';
import StatusBadge from './StatusBadge.astro';
import Chips from './Chips.astro';
import ActionLink from './ActionLink.astro';
import Blood from './Blood.astro';

interface Props {
  project: Project;
  headingLevel?: 2 | 3;
}

const t = useStrings();
const { project, headingLevel = 3 } = Astro.props;
const p = project.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const live = p.status === 'live' && p.url ? p.url : undefined;
const repo = !live && p.repo ? repoUrl(p.repo) : undefined;
---

<article class:list={['card', { live }]} data-trace>
  {live && <Blood kind="corner" scale={3} bottom="-1px" right="-1px" flip="xy" />}
  <ProjectIcon icon={p.icon} logo={p.logo} />
  <div class="body">
    <div class="title">
      <Heading class="name">
        <a class="main" href={`/projects/${p.slug}`}>{p.name}</a>
      </Heading>
      <StatusBadge status={p.status} />
      {live && <ActionLink class="visit" href={live} label="visit" icon="external" ariaLabel={t.projects.openLive(p.name)} external />}
      {repo && <ActionLink class="visit" href={repo} icon="github" ariaLabel={t.projects.openRepo(p.name)} external />}
    </div>
    <p class="tagline">{p.tagline}</p>
    <Chips items={p.stack} max={2} />
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--s2);
    height: 100%;
    padding: var(--s2);
    background: var(--inner);
    border: var(--border-w) solid var(--line);
    transition:
      border-color var(--t-fast) var(--ease),
      background-color var(--t-fast) var(--ease);
  }
  /* without the script, hover just turns the border red; with it, site.js draws it */
  :global(html:not(.has-trace)) .card:has(.main:hover) {
    border-color: var(--accent);
  }
  .card:has(.main:hover) {
    background: color-mix(in srgb, var(--inner), white 2%);
  }
  .card:has(.main:focus-visible) {
    outline: 2px solid var(--text-strong);
    outline-offset: 3px;
  }

  /* the name link covers the whole card */
  .main::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .main:focus-visible {
    outline: none;
  }

  .body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s1);
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s1) var(--s2);
  }
  .title :global(.visit) {
    margin-left: auto;
  }
  .name {
    font-size: var(--fs-md);
    font-weight: 700;
    line-height: 1.5;
    color: var(--text-strong);
  }
  .tagline {
    font-size: var(--fs-sm);
    color: var(--text-soft);
  }
</style>
