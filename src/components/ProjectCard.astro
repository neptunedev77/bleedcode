---
import type { Project } from '../lib/projects';
import ProjectIcon from './ProjectIcon.astro';
import StatusBadge from './StatusBadge.astro';
import Chips from './Chips.astro';

interface Props {
  project: Project;
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 3 } = Astro.props;
const p = project.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<a class="card" href={`/projects/${p.slug}`}>
  <ProjectIcon icon={p.icon} logo={p.logo} />
  <div class="body">
    <div class="title">
      <Heading class="name">{p.name}</Heading>
      <StatusBadge status={p.status} />
    </div>
    <p class="tagline">{p.tagline}</p>
    <Chips items={p.stack} max={2} />
  </div>
</a>

<style>
  .card {
    display: flex;
    align-items: flex-start;
    gap: var(--s2);
    height: 100%;
    padding: var(--s2);
    background: var(--inner);
    border: var(--border-w) solid var(--line);
  }
  .card:hover {
    border-color: var(--accent);
  }
  .body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s1);
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s1) var(--s2);
  }
  .name {
    font-size: var(--fs-md);
    font-weight: 700;
    line-height: 1.5;
    color: var(--text-strong);
  }
  .tagline {
    font-size: var(--fs-sm);
    color: var(--text-soft);
  }
</style>
