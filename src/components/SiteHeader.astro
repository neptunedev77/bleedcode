---
/**
 * Card header. `home`: wordmark, one-line intro, nav, and the cat sitting on
 * the divider. `compact` (sub-pages): small wordmark linking home, and the nav.
 */
import { site } from '../site.config';
import { useStrings } from '../i18n';
import Wordmark from './Wordmark.astro';
import Nav from './Nav.astro';
import Mascot from './Mascot.astro';

interface Props {
  variant?: 'home' | 'compact';
}

const t = useStrings();
const { variant = 'compact' } = Astro.props;
---

{
  variant === 'home' ? (
    <header class="header home">
      <div class="intro">
        <h1>
          <Wordmark />
        </h1>
        <p class="lead">{site.intro}</p>
        <Nav />
      </div>
      <Mascot class="cat" />
    </header>
  ) : (
    <header class="header compact">
      <a href="/" aria-label={t.nav.home}>
        <Wordmark size="sm" />
      </a>
      <Nav />
    </header>
  )
}

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    border-bottom: var(--border-w) solid var(--line);
  }

  /* home: the cat's feet rest on the bottom border */
  .home {
    align-items: flex-end;
    gap: var(--s3);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    padding-bottom: var(--s3);
    max-width: 46ch;
  }
  .lead {
    color: var(--text-soft);
  }
  .home :global(.cat) {
    margin: 0 var(--s3) 0 auto;
  }

  /* sub-pages */
  .compact {
    align-items: center;
    gap: var(--s2) var(--s4);
    padding-bottom: var(--s3);
  }
  .compact > a:hover :global(.wordmark) {
    color: var(--text-strong);
  }

  /* on phones the cat drops below the intro, so the intro needs no bottom space */
  @media (max-width: 560px) {
    .intro {
      padding-bottom: 0;
    }
  }
</style>
