---
/**
 * The one header, identical on every page: wordmark (always the same size),
 * text nav with an active state, and square icon buttons (GitHub, contact).
 * It keeps its place during page transitions (view-transition-name).
 */
import { site } from '../site.config';
import { useStrings } from '../i18n';
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';

const t = useStrings();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: t.nav.home, match: (p: string) => p === '/' },
  { href: '/projects', label: t.nav.projects, match: (p: string) => p === '/projects' || p.startsWith('/projects/') },
  { href: '/me', label: t.nav.me, match: (p: string) => p === '/me' },
];
---

<header class="header">
  <a class="logo" href="/" aria-label={t.nav.logo}>
    <Wordmark />
  </a>

  <nav aria-label={t.nav.label}>
    <ul>
      {
        links.map((l) => {
          const active = l.match(path);
          const current = active ? (path === l.href ? 'page' : 'true') : undefined;
          return (
            <li>
              <a class:list={['nav-link', { active }]} href={l.href} aria-current={current}>
                {l.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <div class="actions">
    <a class="icon-btn" href={site.github} aria-label={t.nav.github} data-trace>
      <Icon name="github" />
    </a>
    <a class="icon-btn" href={`mailto:${site.email}`} aria-label={t.nav.contact} data-copy={site.email} data-trace>
      <Icon name="mail" />
    </a>
  </div>
</header>

<style>
  .header {
    view-transition-name: site-header;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'logo nav actions';
    align-items: center;
    gap: var(--s2) var(--s4);
    padding-bottom: var(--s3);
    border-bottom: var(--border-w) solid var(--line);
  }

  .logo {
    grid-area: logo;
    display: flex;
    align-items: center;
    height: 40px;
  }

  nav {
    grid-area: nav;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-link {
    color: var(--text-soft);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .nav-link:hover {
    color: var(--text-strong);
    text-decoration-color: var(--accent);
  }
  .nav-link.active {
    color: var(--text-strong);
    text-decoration-color: var(--text-strong);
  }

  .actions {
    grid-area: actions;
    display: flex;
    gap: var(--s1);
  }
  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--text-soft);
    border: var(--border-w) solid var(--line-strong);
  }
  .icon-btn:hover {
    color: var(--text-strong);
  }
  :global(html:not(.has-trace)) .icon-btn:hover {
    border-color: var(--accent);
  }

  @media (max-width: 640px) {
    .header {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'logo actions'
        'nav nav';
    }
  }
</style>
