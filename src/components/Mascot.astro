---
/**
 * The bleedcode cat. Always an integer multiple of the 38×43 sprite,
 * drawn with pixelated rendering. The sprite (public/mascot/gato.png) is
 * generated by scripts/build-cat.py with an outline and rim light so it
 * reads on the dark background. Its feet are on the image's bottom edge,
 * so placing the image's bottom on a line makes the cat sit on it.
 */
import { useStrings } from '../i18n';

interface Props {
  /** Pixel multiple on wide screens. */
  scale?: 2 | 3 | 4;
  /** Pixel multiple below 560px. */
  scaleSmall?: 2 | 3 | 4;
  alt?: string;
  class?: string;
}

const SPRITE_W = 38;
const SPRITE_H = 43;

const t = useStrings();
const { scale = 4, scaleSmall = 3, alt = t.mascot.alt, class: className } = Astro.props;
---

<img
  class:list={['mascot', className]}
  src="/mascot/gato.png"
  width={SPRITE_W * scale}
  height={SPRITE_H * scale}
  alt={alt}
  decoding="async"
  style={{
    '--w': `${SPRITE_W * scale}px`,
    '--h': `${SPRITE_H * scale}px`,
    '--w-sm': `${SPRITE_W * scaleSmall}px`,
    '--h-sm': `${SPRITE_H * scaleSmall}px`,
  }}
/>

<style>
  .mascot {
    flex: none;
    width: var(--w);
    height: var(--h);
    image-rendering: pixelated;
  }
  @media (max-width: 560px) {
    .mascot {
      width: var(--w-sm);
      height: var(--h-sm);
    }
  }
</style>
