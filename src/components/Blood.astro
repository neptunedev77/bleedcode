---
/**
 * Pixel-art blood: pools, splashes, smears and specks in three tones
 * (dried --blood, old --blood-dark and a fresh --accent highlight).
 * Absolutely positioned on its (relative) parent with top/right/bottom/left.
 * Decorative only: hidden from assistive tech and ignores the pointer.
 */
type Run = readonly [x: number, y: number, w: number];
interface Shape {
  w: number;
  h: number;
  blood: readonly Run[];
  dark?: readonly Run[];
  light?: readonly Run[];
}

const shapes = {
  /** splash hugging a top-left corner (flip for other corners) */
  corner: {
    w: 12,
    h: 12,
    blood: [
      [0, 0, 7], [0, 1, 9], [0, 2, 10], [0, 3, 8], [0, 4, 6], [0, 5, 5],
      [0, 6, 4], [0, 7, 4], [0, 8, 3], [0, 9, 2], [0, 10, 2], [0, 11, 1],
      [10, 4, 1], [11, 2, 1], [6, 7, 1], [4, 10, 1],
    ],
    dark: [[5, 0, 2], [7, 1, 2], [8, 2, 2], [6, 3, 2], [4, 4, 2], [3, 5, 2], [2, 7, 2]],
    light: [[1, 1, 2], [1, 2, 1]],
  },
  /** wide pool lying on a line */
  pool: {
    w: 18,
    h: 5,
    blood: [[5, 0, 7], [2, 1, 13], [0, 2, 18], [1, 3, 16], [4, 4, 9]],
    dark: [[0, 2, 2], [16, 2, 2], [1, 3, 3], [13, 3, 4], [4, 4, 9]],
    light: [[6, 1, 3], [5, 2, 1]],
  },
  /** flat smear along an edge */
  smear: {
    w: 16,
    h: 4,
    blood: [[2, 0, 8], [0, 1, 14], [1, 2, 15], [5, 3, 6]],
    dark: [[2, 0, 2], [12, 1, 2], [13, 2, 3], [5, 3, 6]],
    light: [[3, 1, 4]],
  },
  /** a few loose drops */
  specks: {
    w: 8,
    h: 6,
    blood: [[0, 1, 1], [3, 0, 1], [5, 3, 1], [2, 4, 1], [7, 5, 1]],
  },
} as const satisfies Record<string, Shape>;

interface Props {
  kind: keyof typeof shapes;
  /** CSS px per grid cell (integers keep it crisp), and below 560px. */
  scale?: number;
  scaleSmall?: number;
  top?: string;
  right?: string;
  bottom?: string;
  left?: string;
  flip?: 'x' | 'y' | 'xy';
  /** Round the shape's top-left corner (before flipping) to match a rounded box. */
  radius?: string;
  class?: string;
}

const { kind, scale = 3, scaleSmall = scale, top, right, bottom, left, flip, radius, class: className } = Astro.props;
const shape: Shape = shapes[kind];
const path = (runs: readonly Run[] = []) => runs.map(([x, y, w]) => `M${x} ${y}h${w}v1h-${w}z`).join('');
const transform = flip === 'x' ? 'scaleX(-1)' : flip === 'y' ? 'scaleY(-1)' : flip === 'xy' ? 'scale(-1)' : undefined;
---

<svg
  class:list={['blood', className]}
  viewBox={`0 0 ${shape.w} ${shape.h}`}
  width={shape.w * scale}
  height={shape.h * scale}
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
  style={{
    top,
    right,
    bottom,
    left,
    transform,
    borderTopLeftRadius: radius,
    overflow: radius ? 'hidden' : undefined,
    '--bw': `${shape.w * scale}px`,
    '--bh': `${shape.h * scale}px`,
    '--bw-sm': `${shape.w * scaleSmall}px`,
    '--bh-sm': `${shape.h * scaleSmall}px`,
  }}
>
  <path class="b" d={path(shape.blood)}></path>
  {shape.dark && <path class="d" d={path(shape.dark)} />}
  {shape.light && <path class="l" d={path(shape.light)} />}
</svg>

<style>
  .blood {
    position: absolute;
    z-index: 1;
    width: var(--bw);
    height: var(--bh);
    image-rendering: pixelated;
    pointer-events: none;
  }
  .b {
    fill: var(--blood);
  }
  .d {
    fill: var(--blood-dark);
  }
  .l {
    fill: var(--accent);
  }
  @media (max-width: 560px) {
    .blood {
      width: var(--bw-sm);
      height: var(--bh-sm);
    }
  }
</style>
