---
interface Props {
  items: readonly string[];
  /** Show at most this many (cards use 2). */
  max?: number;
  label?: string;
}

const { items, max = items.length, label } = Astro.props;
---

<ul class="chips" aria-label={label}>
  {items.slice(0, max).map((item) => <li>{item}</li>)}
</ul>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    padding: 0 var(--s1);
    font-size: var(--fs-sm);
    line-height: 1.5;
    background: var(--tile);
    color: var(--text-soft);
  }
</style>
