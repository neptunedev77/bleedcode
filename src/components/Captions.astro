---
import { site } from '../site.config';

const { left, center, right } = site.captions;
---

<div class="captions pixel">
  <p>
    <span class="dot" aria-hidden="true">■</span>{' '}{left.map((line, i) => (i ? [<br />, line] : line))}
  </p>
  <p class="center">{center.map((line, i) => (i ? [<br />, line] : line))}</p>
  <p class="right">{right.map((line, i) => (i ? [<br />, line] : line))}</p>
</div>

<style>
  .captions {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-top: 18px;
    font-size: 11px;
    line-height: 1.5;
    color: var(--muted);
  }
  .dot {
    color: var(--accent);
  }
  .center {
    text-align: center;
  }
  .right {
    text-align: right;
  }
</style>
