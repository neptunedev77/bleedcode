---
/**
 * Heading + quick status filters (all · live · done · wip) + project grid.
 * The filters are plain radio buttons and work with CSS alone (:has). When
 * public/js/site.js runs, it takes over ([data-js]) and animates the change
 * with a view transition.
 * `teaser` adds a row of empty card sketches that fade out under an
 * "explore all" button, to hint that there is more than what is shown.
 */
import type { Project } from '../lib/projects';
import { useStrings } from '../i18n';
import ProjectGrid from './ProjectGrid.astro';
import ActionLink from './ActionLink.astro';

interface Props {
  projects: Project[];
  title: string;
  /** h1 on /projects, h2 on the home page. */
  as?: 'h1' | 'h2';
  /** Unique per page, for the radio group. */
  id?: string;
  /** Show the status filters (default true). */
  filters?: boolean;
  /** Faded empty card sketches with an "explore all" button over them. */
  teaser?: { href: string; label: string };
}

const t = useStrings();
const { projects, title, as: Heading = 'h2', id = 'projects', filters: showFilters = true, teaser } = Astro.props;
const statuses = ['live', 'done', 'wip'] as const;
const filters = [{ value: 'all', label: t.filters.all }, ...statuses.map((s) => ({ value: s, label: t.status[s] }))];
---

<section class="browser" aria-labelledby={`${id}-title`} data-browser>
  <div class="head">
    <Heading id={`${id}-title`} class="label">{title}</Heading>
    {
      showFilters && (
        <fieldset class="filters">
          <legend class="visually-hidden">{t.filters.legend}</legend>
          {filters.map((f, i) => (
            <>
              {i > 0 && (
                <span class="sep" aria-hidden="true">
                  ·
                </span>
              )}
              <input
                class="visually-hidden"
                type="radio"
                name={`${id}-filter`}
                id={`${id}-f-${f.value}`}
                value={f.value}
                checked={f.value === 'all'}
              />
              <label for={`${id}-f-${f.value}`}>{f.label}</label>
            </>
          ))}
        </fieldset>
      )
    }
  </div>

  <ProjectGrid projects={projects} headingLevel={Heading === 'h1' ? 2 : 3} />
  {showFilters && <p class="empty" data-empty hidden>{t.projects.empty}</p>}

  {
    teaser && (
      <div class="teaser">
        <div class="ghost" aria-hidden="true">
          {[0, 1].map(() => (
            <div class="sketch">
              <span class="sk-icon" />
              <span class="sk-lines">
                <span class="sk-bar title" />
                <span class="sk-bar" />
                <span class="sk-bar short" />
              </span>
            </div>
          ))}
        </div>
        <div class="fade">
          <ActionLink href={teaser.href} label={teaser.label} icon="arrow" class="explore" />
        </div>
      </div>
    )
  }
</section>

<style>
  .browser {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s1) var(--s3);
  }

  .filters {
    display: flex;
    align-items: baseline;
    gap: var(--s1);
    margin: 0;
    padding: 0;
    border: 0;
    font-size: var(--fs-sm);
  }
  .sep {
    color: var(--dim);
  }
  label {
    position: relative;
    cursor: pointer;
    color: var(--dim);
    transition: color var(--t-fast) var(--ease);
  }
  /* the active filter's red underline grows from the left */
  label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 260ms var(--ease);
  }
  label:hover {
    color: var(--text-strong);
  }
  input:checked + label {
    color: var(--text-strong);
  }
  input:checked + label::after {
    transform: scaleX(1);
  }
  input:focus-visible + label {
    outline: 2px solid var(--text-strong);
    outline-offset: 3px;
  }

  .empty {
    padding: var(--s4) var(--s3);
    font-size: var(--fs-sm);
    text-align: center;
    color: var(--dim);
    border: var(--border-w) dashed var(--line-strong);
    border-radius: var(--radius-sm);
  }

  /* the filtering itself, when site.js is not running */
  .browser:not([data-js]):has(input[value='live']:checked) :global(.grid > li:not([data-status='live'])),
  .browser:not([data-js]):has(input[value='done']:checked) :global(.grid > li:not([data-status='done'])),
  .browser:not([data-js]):has(input[value='wip']:checked) :global(.grid > li:not([data-status='wip'])) {
    display: none;
  }
  .browser:not([data-js]):has(input[value='live']:checked):not(:has(.grid > li[data-status='live'])) .empty,
  .browser:not([data-js]):has(input[value='done']:checked):not(:has(.grid > li[data-status='done'])) .empty,
  .browser:not([data-js]):has(input[value='wip']:checked):not(:has(.grid > li[data-status='wip'])) .empty {
    display: block !important;
  }

  /* teaser: two empty card sketches (no text, nothing to read) fading out,
     with one clear button on top */
  .teaser {
    position: relative;
    height: 84px;
  }
  .ghost {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 400px), 1fr));
    gap: var(--s2);
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, rgb(0 0 0 / 0.7), transparent 85%);
    mask-image: linear-gradient(to bottom, rgb(0 0 0 / 0.7), transparent 85%);
  }
  .sketch {
    display: flex;
    gap: var(--s2);
    height: 112px;
    padding: var(--s2);
    background: var(--inner);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm);
  }
  .sk-icon {
    flex: none;
    width: 80px;
    height: 80px;
    background: var(--tile);
  }
  .sk-lines {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 4px;
  }
  .sk-bar {
    height: 8px;
    width: 85%;
    background: var(--tile);
  }
  .sk-bar.title {
    height: 12px;
    width: 35%;
  }
  .sk-bar.short {
    width: 55%;
  }
  .fade {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
