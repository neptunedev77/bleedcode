---
/**
 * A pixel-art blood stain, absolutely positioned on its (relative) parent.
 * Decorative only: hidden from assistive tech and ignores the pointer.
 */
import { shapes, runsToPath, type StainPlacement } from '../lib/stains';

type Props = StainPlacement;

const { kind, scale, top, right, bottom, left, flip, hideOnSmall = false } = Astro.props;
const shape = shapes[kind];

const transform =
  flip === 'x' ? 'scale(-1, 1)' : flip === 'y' ? 'scale(1, -1)' : flip === 'xy' ? 'scale(-1, -1)' : undefined;

const style = { top, right, bottom, left, transform };
const layers = [
  { cls: 'blood', d: runsToPath(shape.blood) },
  { cls: 'dark', d: runsToPath('dark' in shape ? shape.dark : []) },
  { cls: 'light', d: runsToPath('light' in shape ? shape.light : []) },
].filter((l) => l.d);
---

<svg
  class:list={['stain', { 'hide-sm': hideOnSmall }]}
  width={shape.w * scale}
  height={shape.h * scale}
  viewBox={`0 0 ${shape.w} ${shape.h}`}
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
  style={style}
>
  {layers.map((l) => <path class={l.cls} d={l.d} />)}
</svg>

<style>
  .stain {
    position: absolute;
    pointer-events: none;
    z-index: 1;
  }
  .blood {
    fill: var(--blood);
  }
  .dark {
    fill: var(--blood-dark);
  }
  .light {
    fill: var(--accent);
  }
  @media (max-width: 560px) {
    .hide-sm {
      display: none;
    }
  }
</style>
