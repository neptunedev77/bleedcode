---
/** "bleedcode" in the pixel font, with "code" in the accent colour. The only pixel-font text. */
interface Props {
  size?: 'lg' | 'sm';
}

const { size = 'lg' } = Astro.props;
---

<span class:list={['wordmark', size]}>bleed<span class="code">code</span></span>

<style>
  .wordmark {
    font-family: var(--font-wordmark);
    font-weight: 400;
    line-height: 1;
    color: var(--text-strong);
    white-space: nowrap;
  }
  .lg {
    font-size: var(--s5);
  }
  .sm {
    font-size: var(--s3);
  }
  .code {
    color: var(--accent);
  }
  @media (max-width: 400px) {
    .lg {
      font-size: var(--s4);
    }
  }
</style>
